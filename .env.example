APP_NAME=AbangananHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=abanganan_hub
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailtrap sandbox in dev — captures mail, never delivers it.
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@abangananhub.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Laravel Reverb (WebSockets) ---
# Three distinct roles. In LOCAL dev all three point at 127.0.0.1 and the
# VITE_* values may interpolate from REVERB_*. In PRODUCTION they must be
# split: the daemon binds to loopback, the app publishes to loopback, and the
# BROWSER connects to the public domain on 443 through the Nginx proxy.
# See plans/hostinger-vps-deployment.md §5.
#
# Windows dev note: use 127.0.0.1, never `localhost` — see context/RULES.md.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="127.0.0.1"
REVERB_PORT=8080
REVERB_SCHEME=http

# Compiled into the JS bundle at `npm run build` — changing these requires a
# REBUILD, not just a config:clear.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- CARTO Basemaps (default map tile style — Voyager) ---
# Free API key, no CARTO account needed: https://carto.com/basemaps/apikey
# (emailed in ~1 min, free up to 5M tile requests/month). Without this, every
# map on the site renders with an "API key required" watermark. Compiled into
# the JS bundle at build time like the REVERB_* keys below — needs a REBUILD
# after changing, not just config:clear.
CARTO_API_KEY=
VITE_CARTO_API_KEY="${CARTO_API_KEY}"

# --- Cloudinary (public media: property/unit photos, avatars, logos) ---
# Government IDs and property documents do NOT go here — they use the private
# local disk. See context/RULES.md § Storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# --- PayMongo (sandbox/test keys only) ---
# The webhook cannot reach localhost; in local dev the checkout-return poll in
# ReconcilesPaymongoCheckout is the only path that settles a payment.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=

# --- Google Cloud Vision (OCR for landlord ID verification) ---
GOOGLE_VISION_API_KEY=

# --- Social login (Laravel Socialite) ---
# Register the callback URL in each provider console separately — changing
# APP_URL updates these values but not the provider's allow-list.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"
